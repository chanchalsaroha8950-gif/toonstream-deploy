# ==============================================
# REQUIRED CONFIGURATION
# ==============================================

# Supabase Configuration (Required)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# TMDB API Key (Required - for fetching metadata)
TMDB_API_KEY=your_tmdb_api_key_here

# ==============================================
# SERVER CONFIGURATION
# ==============================================

# Server Port (Default: 3000)
PORT=3000

# Cron Schedule - How often to sync (Default: every 1 minute)
# Format: */1 * * * * = every 1 minute
#         */5 * * * * = every 5 minutes
#         */10 * * * * = every 10 minutes
#         0 * * * * = every hour
CRON_SCHEDULE=*/1 * * * *

# ==============================================
# SYNC CONFIGURATION
# ==============================================

# Polling interval in milliseconds (Default: 60000 = 1 minute)
POLL_INTERVAL_MS=60000

# Maximum parallel series to process (Default: 4)
# Reduce this if experiencing memory issues
MAX_PARALLEL_SERIES=4

# How many latest episodes to audit (Default: 25)
LATEST_AUDIT_LIMIT=25

# How many episodes to check for missing servers (Default: 50)
EMPTY_SERVERS_AUDIT_LIMIT=50

# ==============================================
# PROXY CONFIGURATION
# ==============================================

# Enable/Disable Proxy Rotation (Default: false)
# Set to 'true' to enable proxy rotation
USE_PROXY=false

# Custom Proxy List (Optional)
# Comma-separated list of proxies in format: host:port
# Example: PROXY_LIST=proxy1.com:8080,proxy2.com:3128,proxy3.com:80
# If not provided and USE_PROXY=true, free proxies will be fetched automatically
PROXY_LIST=
